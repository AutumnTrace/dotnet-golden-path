{
  "$schema": "http://json.schemastore.org/template",
  "author": "Mina Rotari",
  "classifications": [
    "Web",
    "WebAPI",
    "Service",
    "Cloud"
  ],
  "identity": "GoldenPath.Api.CSharp",
  "groupIdentity": "GoldenPath.Api",
  "name": "Golden path ASP.NET Core service",
  "description": "A production-ready .NET 10 service: vertical-slice minimal APIs, OpenTelemetry, Serilog, health probes and tests, ready on day one.",
  "shortName": "goldenpath-api",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Company.Service",
  "preferNameDirectory": true,
  "defaultName": "Orders",
  "symbols": {
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Where the service keeps its data. Every choice also runs without Docker using an in-memory store.",
      "choices": [
        {
          "choice": "postgres",
          "description": "PostgreSQL with EF Core 10, migrations, optimistic concurrency and a readiness check"
        },
        {
          "choice": "none",
          "description": "In-memory store only (stateless services, or bring your own persistence)"
        }
      ],
      "defaultValue": "postgres"
    },
    "UsePostgres": {
      "type": "computed",
      "value": "(database == \"postgres\")"
    },
    "messaging": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Asynchronous messaging. Producers and consumers sit behind an outbox-friendly interface with an in-memory transport for local runs.",
      "choices": [
        {
          "choice": "kafka",
          "description": "Kafka producer and consumer (Confluent.Kafka): idempotent producer, at-least-once consumer, retries, dead-letter topic, trace propagation"
        },
        {
          "choice": "none",
          "description": "No messaging"
        }
      ],
      "defaultValue": "none"
    },
    "UseKafka": {
      "type": "computed",
      "value": "(messaging == \"kafka\")"
    },
    "UseIntegrationTests": {
      "type": "computed",
      "value": "(database == \"postgres\" || messaging == \"kafka\")"
    },
    "observability": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Where telemetry (traces, metrics and logs) is exported. Exporters switch on only when their endpoint or connection string is configured.",
      "choices": [
        {
          "choice": "otlp",
          "description": "OTLP exporter (any OpenTelemetry collector, the Aspire dashboard, Grafana, Jaeger, ...)"
        },
        {
          "choice": "appinsights",
          "description": "Azure Monitor exporter (Application Insights)"
        },
        {
          "choice": "both",
          "description": "OTLP and Azure Monitor side by side"
        }
      ],
      "defaultValue": "otlp"
    },
    "UseOtlp": {
      "type": "computed",
      "value": "(observability == \"otlp\" || observability == \"both\")"
    },
    "UseAppInsights": {
      "type": "computed",
      "value": "(observability == \"appinsights\" || observability == \"both\")"
    },
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "description": "How callers authenticate. With jwt every endpoint requires a bearer token unless it opts out explicitly.",
      "choices": [
        {
          "choice": "jwt",
          "description": "JWT bearer tokens from your identity provider (dotnet user-jwts locally), scope-based policies"
        },
        {
          "choice": "none",
          "description": "No authentication (internal services behind a gateway that authenticates)"
        }
      ],
      "defaultValue": "jwt"
    },
    "UseJwt": {
      "type": "computed",
      "value": "(auth == \"jwt\")"
    },
    "serviceSlug": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "slug",
      "replaces": "company-service",
      "fileRename": "company-service"
    }
  },
  "forms": {
    "slug": {
      "identifier": "chain",
      "steps": [
        "nonAlphanumericToDash",
        "kebab"
      ]
    },
    "nonAlphanumericToDash": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9]+",
      "replacement": "-"
    },
    "kebab": {
      "identifier": "kebabCase"
    }
  },
  "guids": [
    "6f0d7c1e-3b9a-4c55-9e2f-1a8b7d4c2e90"
  ],
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.received.*",
        "**/TestResults/**",
        "**/*.user"
      ],
      "modifiers": [
        {
          "condition": "(!UseJwt)",
          "exclude": [
            "src/Company.Service.Api/Infrastructure/Security/**",
            "tests/Company.Service.ApiTests/AuthApiTests.cs",
            "tests/Company.Service.Testing/TestTokens.cs",
            "tests/Company.Service.UnitTests/Infrastructure/AuthScopeTests.cs"
          ]
        },
        {
          "condition": "(!UsePostgres)",
          "exclude": [
            ".config/**",
            "src/Company.Service.Api/Infrastructure/Persistence/**",
            "src/Company.Service.Api/Features/Orders/Persistence/**",
            "tests/Company.Service.IntegrationTests/Postgres/**"
          ]
        },
        {
          "condition": "(!UseKafka)",
          "exclude": [
            "src/Company.Service.Api/Infrastructure/Messaging/**",
            "src/Company.Service.Api/Features/Orders/OrderMessages.cs",
            "src/Company.Service.Api/Features/Orders/MarkOrderPaid.cs",
            "tests/Company.Service.UnitTests/Messaging/**",
            "tests/Company.Service.ApiTests/MessagingApiTests.cs",
            "tests/Company.Service.IntegrationTests/Kafka/**",
            "tests/Company.Service.UnitTests/Fakes/RecordingPublisher.cs"
          ]
        },
        {
          "condition": "(!UseIntegrationTests)",
          "exclude": [
            "tests/Company.Service.IntegrationTests/**"
          ]
        },
        {
          "condition": "(UseJwt)",
          "exclude": [
            "tests/Company.Service.ApiTests/Snapshots/openapi-v1.none.approved.json"
          ],
          "rename": {
            "tests/Company.Service.ApiTests/Snapshots/openapi-v1.jwt.approved.json": "tests/Company.Service.ApiTests/Snapshots/openapi-v1.approved.json"
          }
        },
        {
          "condition": "(!UseJwt)",
          "exclude": [
            "tests/Company.Service.ApiTests/Snapshots/openapi-v1.jwt.approved.json"
          ],
          "rename": {
            "tests/Company.Service.ApiTests/Snapshots/openapi-v1.none.approved.json": "tests/Company.Service.ApiTests/Snapshots/openapi-v1.approved.json"
          }
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "Company.Service.slnx"
    }
  ]
}
