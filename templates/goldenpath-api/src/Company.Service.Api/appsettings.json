{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "Polly": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Observability": {
    "LogFormat": "Json",
    "TraceSampleRatio": 1.0
  },
  //#if (UseJwt)
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [ "company-service" ]
      }
    }
  },
  //#endif
  "CustomerDirectory": {
    "BaseAddress": "http://customer-directory/",
    "UseStub": false,
    "Resilience": {
      "TotalRequestTimeout": { "Timeout": "00:00:10" },
      "Retry": {
        "MaxRetryAttempts": 3,
        "BackoffType": "Exponential",
        "UseJitter": true,
        "Delay": "00:00:00.200"
      },
      "CircuitBreaker": {
        "FailureRatio": 0.2,
        "MinimumThroughput": 20,
        "SamplingDuration": "00:00:30",
        "BreakDuration": "00:00:15"
      },
      "AttemptTimeout": { "Timeout": "00:00:02" }
    }
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:00:01"
  },
  "Shutdown": {
    "DrainDelay": "00:00:05",
    "Timeout": "00:00:25"
  }
}
